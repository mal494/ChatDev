# ============================================================================
# ChatDev 2.0 (DevAll) — Environment Configuration
# ============================================================================
# Copy this file to `.env` and adjust the values:
#     cp .env.example .env
#
# Everything here is optional at startup — sensible defaults are built into
# the code — but the LLM provider settings are required for real agent runs.
#
# YAML workflow files may reference any of these variables as ${VAR}
# placeholders (e.g. ${API_KEY}); they are resolved from the process
# environment (including this file) at run time.

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Base URL of the LLM provider and the API key used for model-call
# authentication. These support OpenAI, Gemini, LM Studio, Ollama and other
# OpenAI-compatible providers.
# - OpenAI:    https://api.openai.com/v1
# - Gemini:    https://generativelanguage.googleapis.com
# - LM Studio: http://localhost:1234/v1
# - Ollama:    http://localhost:11434/v1
BASE_URL=http://localhost:11434/v1
API_KEY=ollama

# ============================================================================
# Optional: Web Search and Reading Tools
# ============================================================================
# SERPER_DEV_API_KEY=your-serper-api-key-here
# Get from: https://serper.dev
# JINA_API_KEY=your-jina-api-key-here
# Get from: https://jina.ai

# Memory provider key (used by the mem0 memory node; only needed if you use it)
# MEM0_API_KEY=your-mem0-api-key-here

# ============================================================================
# Backend server (server_main.py)
# ============================================================================
# Address the backend binds to. Default: 0.0.0.0
BACKEND_BIND=0.0.0.0
# Backend port used by the Docker Compose deployment (the standalone server
# takes the port via --port; its CLI default is 8000).
# PORT=6400

# Comma-separated list of allowed CORS origins (browser clients).
# Defaults to localhost/127.0.0.1 on any port for dev.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "development" exposes extra debug details in 500 error responses.
# Leave unset (or set to "production") in production deployments.
# ENVIRONMENT=development

# Logging: level for the structured logger, and where server / workflow logs go.
# Defaults: LOG_LEVEL=INFO, SERVER_LOG_FILE=logs/server.log,
#           WORKFLOW_LOG_FILE=logs/<workflow-name>.log
# LOG_LEVEL=INFO
# SERVER_LOG_FILE=logs/server.log
# WORKFLOW_LOG_FILE=logs/workflow.log

# SQLite database path for Vue graph editor payloads. Default: data/vuegraphs.db
# VUEGRAPHS_DB_PATH=data/vuegraphs.db

# Working directory for ephemeral generated code. Default: temp
# TEMP_CODE_DIR=temp

# Timeout (seconds) for `uv` library installs executed by workflows. Default: 120
# LIB_INSTALL_TIMEOUT=120

# "1" to auto-clean uploaded attachments (server/services/attachment_service.py).
# MAC_AUTO_CLEAN_ATTACHMENTS=0

# Override directories scanned for dynamic functions / edge functions /
# edge processors (defaults to functions/function_calling, functions/edge,
# functions/edge_processor).
# MAC_FUNCTIONS_DIR=functions/function_calling
# MAC_EDGE_FUNCTIONS_DIR=functions/edge
# MAC_EDGE_PROCESSOR_FUNCTIONS_DIR=functions/edge_processor

# ============================================================================
# Frontend (Vite dev server, ./frontend)
# ============================================================================
# Host/port the Vite dev server listens on. Defaults: 0.0.0.0 / 5173
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
# API base URL the frontend uses at dev time (also the Vite /api proxy target).
# Leave unset for same-origin (the Vite proxy defaults to http://localhost:6400).
VITE_API_BASE_URL=http://localhost:6400

# ============================================================================
# Standalone agent CLI (chatdev_agent/ — optional, not needed for the server)
# ============================================================================
# Backend used by the standalone `chatdev_agent` demo: offline | ollama | openai.
# CHATDEV_BACKEND=offline
# OLLAMA_MODEL=qwen2.5
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# CHATDEV_API_BASE=http://localhost:8080/v1
# CHATDEV_API_KEY=local

# Storage location used by the standalone agent (defaults to ./AI_Data).
# CHATDEV_DATA_DIR=./AI_Data
# AI_DATA_DRIVE=E:
